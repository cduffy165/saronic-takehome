# Copy to .streamlit/secrets.toml (gitignored) for local development.
# Values below match the dev-only Keycloak realm fixture in keycloak/realm-export.json.
# Not used in production; production identity is out of scope for this POC.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "changeme-dev-only-cookie-signing-secret"
client_id = "factory-ui"
client_secret = "factory-ui-dev-secret"
server_metadata_url = "http://auth.localhost:8080/realms/factory/.well-known/openid-configuration"
