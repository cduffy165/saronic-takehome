FROM python:3.14-slim

WORKDIR /app

# claude-agent-sdk (factory/agents/plan_session.py) drives the real Claude Code
# CLI as a subprocess over stdio — it's a thin Python wrapper, not a standalone
# API client. Node + the CLI package have to be present in this image for the
# Plan session to run at all.
RUN apt-get update && apt-get install -y --no-install-recommends nodejs npm curl git \
    && npm install -g @anthropic-ai/claude-code \
    && rm -rf /var/lib/apt/lists/*

# Secrets-scan hard gate (factory/agents/secrets_scanner.py) shells out to
# gitleaks — a single static binary, no runtime dependencies. Version pinned
# to match what's used for local dev/testing.
RUN curl -sSL https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz \
    | tar -xz -C /usr/local/bin gitleaks

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY README.md ./
COPY factory ./factory
COPY blueprints ./blueprints
COPY evals ./evals

RUN uv sync --frozen --no-dev

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "factory.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
