FROM python:3.13-slim

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY README.md ./
COPY factory ./factory
# The registry UI resolves Keycloak subs to display names from this fixture
# realm export (factory/registry/identity.py) rather than calling Keycloak's
# admin API on every page render.
COPY keycloak ./keycloak
COPY .streamlit/config.toml .streamlit/config.toml

RUN uv sync --frozen --no-dev

EXPOSE 8501

CMD ["uv", "run", "streamlit", "run", "factory/ui/app.py", "--server.address=0.0.0.0", "--server.port=8501"]
