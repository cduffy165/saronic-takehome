# Copy to .env. Used for local (host-side) commands: alembic, make seed, manual
# scripts. Also read by docker compose itself for ${VAR} substitution in
# compose.yaml (e.g. ANTHROPIC_API_KEY) — that's compose's own var
# substitution, not something the containers read directly.
DATABASE_URL=postgresql+psycopg://factory:factory@localhost:5432/factory

# Required to run the Plan session (factory/agents/plan_session.py calls the
# real Claude Agent SDK, which makes real, billed API calls).
ANTHROPIC_API_KEY=sk-ant-...

# Required for Build to push generated apps to Gitea. Run `make gitea-init`
# once (after `docker compose up`) and paste the printed token here, then
# restart the api service (it reads this at startup).
GITEA_TOKEN=
